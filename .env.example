# Database
DATABASE_URL="postgresql://wos:wos_dev_password_change_in_production@localhost:5432/wos_links?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Providers (Multi-provider with automatic fallback)
# Primary: OpenRouter → Fallbacks: Anthropic, Gemini, OpenAI

# OpenRouter (Primary - supports all models)
OPENROUTER_API_KEY="sk-or-v1-..."

# Anthropic Claude (Fallback)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (Fallback)
GOOGLE_API_KEY="AIza..."

# OpenAI (Fallback + Embeddings)
OPENAI_API_KEY="sk-..."

# NextAuth (authentication)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# OAuth Providers (optional - for social login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Stripe (payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Bunny CDN
BUNNY_API_KEY="..."
BUNNY_STORAGE_API_KEY="..."
BUNNY_PULL_ZONE_ID="..."
BUNNY_EDGE_KV_NAMESPACE="wos-links"

# Edge Script
EDGE_SECRET_KEY="generate-a-random-secret-for-edge-scripts"

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_DOMAIN="wos.link"

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_VECTOR_SEARCH=true
ENABLE_REVENUE_TRACKING=true
